# Скопируй этот файл как .env и вставь свои значения.
# Токен выдаёт @BotFather. Никому его не показывай.

BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHANNEL=@abmrab

# Папка с баннерами. Относительный путь считается от папки скрипта, не от cwd.
# Абсолютный путь (Railway Volume): /data/banners
BANNERS_DIR=banners
