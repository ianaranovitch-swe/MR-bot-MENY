# Скопируй этот файл как .env и вставь свои значения.
# Токен выдаёт @BotFather. Никому его не показывай.

BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Канал, куда бот @MRAB_SWE_bot публикует меню.
CHANNEL=@abmrab

# Папка с баннерами. Относительный путь считается от папки скрипта, не от cwd.
# Абсолютный путь (Railway Volume): /data/banners
BANNERS_DIR=banners

# Telegram user id админов через запятую. Узнать id: @userinfobot
ADMIN_IDS=111111111,222222222

# На Railway появляется сама после добавления Postgres.
# Локально: строка подключения к своей базе.
DATABASE_URL=postgresql://user:password@localhost:5432/menybot
